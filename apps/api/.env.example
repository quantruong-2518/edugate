# NestJS bind
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database — dev uses one superuser URL; production splits per Postgres role.
# Default port = 5433 (local brew postgres@17). docker-compose ships 5432 but
# 5432 is commonly occupied by an existing Postgres install on dev machines.
DATABASE_URL=postgres://huydd@localhost:5433/edugate
# DATABASE_URL_APP=postgres://app_role:...@localhost:5432/edugate
# DATABASE_URL_PLATFORM=postgres://platform_role:...@localhost:5432/edugate
# DATABASE_URL_MAINTENANCE=postgres://maintenance_role:...@localhost:5432/edugate

# Redis (BullMQ + rate limit)
REDIS_URL=redis://localhost:6379

# Object storage — Cloudflare R2 (S3-compatible).
# Endpoint is derived from R2_ACCOUNT_ID; region is always `auto` for R2.
# Bucket is created in the Cloudflare dashboard; access keys are scoped to it.
# Presigned PUT URLs expire after R2_SIGNED_TTL seconds (default 300).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_TTL=300

# Email — Resend prod; in dev the worker logs to console.
RESEND_API_KEY=
EMAIL_FROM=noreply@tuyensinhnhanh.vn

# Auth (Better-Auth wired Day 6+)
AUTH_SECRET=replace-me-32-bytes-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
