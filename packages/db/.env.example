# Drizzle Kit + migrate.ts read DATABASE_URL_MAINTENANCE first, then fall back
# to DATABASE_URL. In dev a single superuser URL is fine; production splits
# into three URLs, one per Postgres role (see src/client.ts).

# Default port = 5433 (local brew postgres@17). docker-compose ships 5432.
DATABASE_URL=postgres://huydd@localhost:5433/edugate
# DATABASE_URL_APP=postgres://app_role:...@localhost:5432/edugate
# DATABASE_URL_PLATFORM=postgres://platform_role:...@localhost:5432/edugate
# DATABASE_URL_MAINTENANCE=postgres://maintenance_role:...@localhost:5432/edugate
